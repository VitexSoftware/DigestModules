{
    "name": "vitexsoftware/digest-modules",
    "description": "Data collection modules for accounting system digest reports",
    "type": "library",
    "keywords": ["digest", "analytics", "accounting", "abraflexi", "data"],
    "homepage": "https://github.com/VitexSoftware/DigestModules",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Vítězslav Dvořák",
            "email": "info@vitexsoftware.cz",
            "homepage": "https://vitexsoftware.cz"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "VitexSoftware\\DigestModules\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VitexSoftware\\DigestModules\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "minimum-stability": "stable"
}