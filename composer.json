{
    "name": "vitexsoftware/digest-modules",
    "description": "System-agnostic data collection modules for accounting digest reports, Zabbix monitoring, and analytics",
    "type": "library",
    "keywords": ["digest", "analytics", "accounting", "zabbix", "data", "modules"],
    "homepage": "https://github.com/VitexSoftware/DigestModules",
    "license": "MIT",
    "authors": [
        {
            "name": "Vítězslav Dvořák",
            "email": "info@vitexsoftware.cz",
            "homepage": "https://vitexsoftware.cz"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-gettext": "*",
        "ext-intl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "VitexSoftware\\DigestModules\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VitexSoftware\\DigestModules\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "*"
    },
    "minimum-stability": "stable"
}
